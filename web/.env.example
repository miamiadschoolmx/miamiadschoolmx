# ─────────────────────────────────────────────────────────────────────────────
# Copia este archivo como .env.local (en tu equipo) o captura estas variables en
# tu hosting (Vercel → Settings → Environment Variables).
# NUNCA subas .env.local al repositorio. Ningún valor aquí es real.
# Las páginas se generan en build: si cambias una variable, vuelve a desplegar.
# Detalle de cada una: README.md → "Conectar integraciones".
# ─────────────────────────────────────────────────────────────────────────────

# Dominio público final, sin barra al final (canonical, sitemap, Open Graph).
SITE_URL=

# ── Registro (Systeme.io) ────────────────────────────────────────────────────
# Opción A (recomendada): API pública. Sólo servidor; nunca con NEXT_PUBLIC_.
SYSTEME_API_KEY=
# ID numérico de la etiqueta que dispara la secuencia de acceso al VSL.
# Puedes agregar más IDs separados por coma (p. ej. newsletter de viernes).
SYSTEME_LEAD_TAG_IDS=

# Opción B/C: script del Inline form de Systeme.io  ->  <script ...></script>
#             o URL de una página de registro alojada en Systeme.io -> https://...
# Se ignora si la opción A está configurada.
SYSTEME_FORM_EMBED_OR_URL=

# Retorno tras registro correcto (ruta interna o https). Por defecto: /vsl
SYSTEME_VSL_SUCCESS_URL=/vsl

# ── Video ────────────────────────────────────────────────────────────────────
# [PEGAR AQUÍ EL EMBED DEL VSL] URL del reproductor (iframe) o código embed.
VSL_EMBED=

# ── Agenda, WhatsApp y aviso de privacidad ───────────────────────────────────
BOOKING_URL=
# Formato: https://wa.me/52XXXXXXXXXX  (no inventes el número)
WHATSAPP_URL=
PRIVACY_URL=

# ── Analítica (vacío = no se carga ningún script) ────────────────────────────
GA4_MEASUREMENT_ID=
META_PIXEL_ID=

# Sólo para previews de staging: muestra etiquetas y simulaciones de desarrollo
# en un build de producción. NUNCA en el dominio público.
DEV_PLACEHOLDERS=
